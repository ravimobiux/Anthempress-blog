# ============================================
# WordPress .gitignore for blog.anthempress.com
# ============================================

# --- Database dumps (NEVER commit) ---
*.sql
*.sql.gz
wordpress_db.sql*

# --- Production credentials backup (NEVER commit) ---
wp-config-prod.php.bak
wp-config-local.php
.env
.env.*

# --- Uploads (media files - keep on server only) ---
wp-content/uploads/
!wp-content/uploads/.gitkeep

# --- Cache & generated files ---
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/backup-db/
wp-content/backups/
wp-content/ai1wm-backups/
wp-content/wpvivid-backups/
wp-content/litespeed/
wp-content/w3tc-config/
wp-content/object-cache.php
wp-content/advanced-cache.php

# --- Logs & debug ---
*.log
wp-content/debug.log
error_log
access_log

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE & editor ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
.project
.settings/

# --- Node.js (if any) ---
node_modules/
package-lock.json
npm-debug.log
yarn-error.log

# --- Composer ---
vendor/
composer.lock

# --- Backup files ---
*.bak
*.old
*.orig
*.save
*~

# --- WP-CLI cache ---
.wp-cli/

# --- Keep .htaccess out (nginx setup anyway) ---
.htaccess
.htaccess.bak

# --- WordPress core (reinstallable via WP-CLI) ---
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-config-sample.php
/index.php
/xmlrpc.php
/license.txt
/readme.html

# --- Default & third-party themes (from wordpress.org) ---
wp-content/themes/twenty*/
wp-content/themes/twentytwenty*/
!wp-content/themes/twentytwentyfive-child/
!wp-content/themes/twentytwentyfive-child/**

# --- Third-party plugins (from wordpress.org) ---
wp-content/plugins/akismet/
wp-content/plugins/hello.php
wp-content/plugins/wordpress-importer/
